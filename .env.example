# ==============================================================================
# SRU Assistant - Environment Configuration Template
# Copy this file to '.env' and populate with local values.
# NEVER commit real secrets or API keys to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="SRU Assistant"
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Generator & LLM Configuration (Phase 4)
# Supported providers: deterministic (rule-based baseline), ollama, openai_compatible
LLM_PROVIDER=deterministic
LLM_MODEL=qwen3.5:0.8b
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60.0
LLM_ENABLE_THINKING=false
LLM_ENDPOINT_MODE=chat
RAG_CONTEXT_MAX_TOKENS=1500
RAG_RELEVANCE_THRESHOLD=0.40

# Grounded Generation Configuration (Phase 7)
GROUNDING_VALIDATION_ENABLED=true
GROUNDING_STRICT_MODE=false
CONFLICT_DETECTION_ENABLED=true
GROUNDED_SYSTEM_PROMPT_STYLE=default
GROUNDING_MIN_TOKEN_OVERLAP=0.4

# Citation & Provenance Configuration (Phase 8)
CITATION_STYLE=inline_bracket
CITATION_VERIFICATION_ENABLED=true
CITATION_MIN_SUPPORT_SCORE=0.5
CITATION_REQUIRE_EXACT_ENTITIES=true

# Embedding Configuration (Phase 3)
# Supported providers: fasthash (deterministic lexical baseline), ollama, sentence_transformers
EMBEDDING_PROVIDER=fasthash
EMBEDDING_MODEL=fasthash-384
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=30.0

# Vector Store Configuration (Phase 3)
VECTORSTORE_BACKEND=sqlite
VECTORSTORE_PATH=./data/vectorstore/sru_vectors.db
VECTORSTORE_MANIFEST_PATH=./data/vectorstore/index_manifest.json
VECTORSTORE_COLLECTION_NAME=sru_academic_docs

# Document Processing Directories
RAW_DOCUMENTS_DIR=./documents/raw
PROCESSED_DOCUMENTS_DIR=./documents/processed

# Retrieval Parameters
RETRIEVAL_TOP_K=5
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_RERANKING_ENABLED=false

# Retrieval Enhancement & Re-ranking Configuration (Phase 6)
RERANKER_TYPE=deterministic
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_K=20
RETRIEVAL_FILTER_MODE=soft
QUERY_ANALYSIS_ENABLED=true
ALLOW_RERANKER_FALLBACK=false
SOFT_FILTER_BOOST=0.15
SOFT_FILTER_PENALTY=0.15

# Hybrid Retrieval Configuration (Phase 5)
RETRIEVAL_MODE=hybrid
HYBRID_FUSION_METHOD=rrf
HYBRID_DENSE_CANDIDATE_K=20
HYBRID_LEXICAL_CANDIDATE_K=20
HYBRID_FINAL_TOP_K=5
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.5
HYBRID_LEXICAL_WEIGHT=0.5
HYBRID_ALLOW_FALLBACK=false

# BM25 Lexical Configuration (Phase 5)
BM25_K1=1.5
BM25_B=0.75
BM25_INDEX_PATH=./data/indices/bm25_index.json

