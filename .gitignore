# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing and linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Document storage (keep directory structure and placeholders)
documents/raw/*
!documents/raw/.gitkeep
!documents/raw/README.md
documents/processed/*
!documents/processed/.gitkeep
!documents/processed/README.md

# Backups and temporary migration folders
frontend_backup_pre_redesign/
data/backups/*
!data/backups/.gitkeep
*.bak

# Vector indexes and local runtime data stores
*.faiss
*.chroma
*.sqlite3
data/vectorstore/*
!data/vectorstore/.gitkeep
data/indices/*
!data/indices/.gitkeep

# Benchmark test suites and evaluation data (tracked for reproducibility)
!data/benchmarks/
!data/benchmarks/*

# Logs and runtime artifacts
logs/
*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
